{
  "description": "Edge/ground simulation sweeps on val: edge hardware, onboard vs split detection, and network latency / bandwidth / loss / deadline. Each group varies one factor from the base; identical configurations are run once.",
  "datasets": ["uavdt", "visdrone"],
  "split": "val",
  "yolo": "outputs/yolo_runs/retrain_aug_m_lowlr/weights/best.pt",
  "felnet": "outputs/felnet_runs/full_run/best.pt",
  "ground_cache": "outputs/sim/detcache/val_jpeg90.npz",
  "host_cpus": "0-15",
  "edge_common": ["--conf", "0.55", "--no-appearance", "--nsa", "--cmc", "--byte", "--byte-low-conf", "0.4",
                  "--codec", "jpeg", "--jpeg-quality", "90", "--realtime", "--camera-fps", "30"],
  "edges": {
    "gpu": ["--device", "cuda"],
    "e8":  ["--device", "cpu", "--edge-cpus", "16-23"],
    "e4":  ["--device", "cpu", "--edge-cpus", "16-19"],
    "e2":  ["--device", "cpu", "--edge-cpus", "16-17"],
    "e1":  ["--device", "cpu", "--edge-cpus", "16"]
  },
  "base": {"edge": "e4", "detector": "ground", "delay_ms": 10, "rate_mbit": 50, "loss": "", "deadline_ms": 150},
  "groups": {
    "hardware":  {"vary": "edge", "values": ["gpu", "e8", "e4", "e2", "e1"]},
    "onboard":   {"vary": "edge", "values": ["gpu", "e8", "e4"], "set": {"detector": "onboard"}},
    "latency":   {"vary": "delay_ms", "values": [0, 10, 25, 50, 100]},
    "bandwidth": {"vary": "rate_mbit", "values": [5, 10, 20, 50, 100]},
    "loss":      {"vary": "loss", "values": ["", "0.1%", "0.5%", "1%", "2%", "5%", "gemodel 1% 25%"]},
    "deadline":  {"vary": "deadline_ms", "values": [100, 150, 250]}
  }
}
